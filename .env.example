# Deixe vazio para o modo minimo (H2 e seguranca aberta).
SPRING_PROFILES_ACTIVE=

# Auth0: usados apenas quando o perfil auth0 estiver ativo.
AUTH0_ISSUER_URI=https://SEU-DOMINIO.us.auth0.com/
AUTH0_AUDIENCE=https://provafinal-api
AUTH0_ROLES_CLAIM=https://projsoft.com/roles

# PostgreSQL: usados apenas quando o perfil postgres estiver ativo.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=provafinal
DB_USER=postgres
DB_PASSWORD=postgres

# Front-end opcional.
CORS_ALLOWED_ORIGINS=http://localhost:5173

